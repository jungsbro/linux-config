configuration {
   modi: "window";
   show-icons: true;
   font: "Sans Bold 16"; /* 글씨를 굵고 크게 */

   /* 질문자님의 무기인 마우스 single click 꼼수 유지 */
   me-select-entry: "";
   me-accept-entry: "MousePrimary";
}

/* 여기서부터 화면을 전체 화면 대시보드로 강제 전환 */
window {
   fullscreen: true;          /* 화면 전체를 꽉 채우는 Fullscreen 모드 */
   background-color: #1a1a1acc; /* 눈이 편안한 반투명 어두운 배경 */
   padding: 10%;              /* 화면 가장자리에 시원하게 여백 주기 */
}

mainbox {
   background-color: transparent;
   children: [ inputbar, listview ]; /* 깔끔하게 검색창과 목록만 표시 */
   spacing: 30px;
}

inputbar {
   background-color: #2d2d2dff;
   text-color: #ffffff;
   border-radius: 8px;
   padding: 15px;
}

/* 핵심: 목록을 텍스트 줄글이 아니라 거대한 바둑판 격자(Grid)로 변경 */
listview {
   background-color: transparent;
   columns: 4;       /* 가로로 4개씩 큼직하게 배치 (모니터 크기에 따라 3~5 조절 가능) */
   lines: 4;         /* 세로 줄 수 */
   spacing: 20px;
   cycle: false;
   dynamic: true;
}

/* 바둑판 안의 개별 창 아이템 상자 */
element {
   background-color: #2d2d2dff;
   text-color: #ffffff;
   orientation: vertical;    /* 아이콘이 위, 글자가 아래로 오게 배치 (Expose 스타일) */
   border-radius: 12px;
   padding: 30px 10px;       /* 상자를 거대하게 키움 */
   alignment: center;
}

element selected {
   background-color: #4f4f4fff; /* 마우스 올렸을 때 하이라이트 */
}

/* 아이콘을 괴물처럼 크게 키우기 */
element-icon {
   background-color: transparent;
   size: 96px;       /* 96픽셀짜리 초거대 아이콘 적용! 눈에 안 들어올 수가 없음 */
   horizontal-align: 0.5;
}

/* 창 제목 글자 세팅 */
element-text {
   background-color: transparent;
   text-color: inherit;
   horizontal-align: 0.5;
   margin: 15px 0px 0px 0px;
}

