# Custom Functions

cmd view ${{
    # 파일 타입을 확인해서 텍스트일 때만 bat 실행 (옵션)
    if [[ -f "$f" ]]; then
        # 방법1)
        # $PAGER "$f"

        # 방법2)
        # /usr/bin/bat --paging=always "$f"
        bat --paging=always "$f"
    fi
}}

cmd mkdir ${{
    printf "Directory Name: "
    read ans
    mkdir $ans
}}

cmd mkfile ${{
    printf "File Name: "
    read ans
    $EDITOR $ans
}}

