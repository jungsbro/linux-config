cmd fzf_jump ${{
    res=$(find . -maxdepth 2 -not -path '*/.*' -type d | fzf)

    if [ -n "$res" ]; then
        lf -remote "send $id cd \"$res\""
    fi
}}

cmd fzf_dir ${{
    # zl: fzf를 이용한 디렉토리 점프 (선택 시 즉시 이동)

    # find로 디렉토리 목록을 뽑고 fzf로 선택합니다.
    # .git 등 숨김 폴더는 제외하는 설정입니다.
    # res=$(find . -maxdepth 3 -not -path '*/.*' -type d | fzf --reverse --header='Jump to Directory')
    res=$(find . -maxdepth 3 -not -path '*/.*' -type d | fzf --header='Jump to Directory')

    # 결과가 있을 경우에만 lf -remote를 통해 해당 경로로 이동합니다.
    if [ -n "$res" ]; then
        lf -remote "send $id cd \"$res\""
    fi
}}

cmd fzf_file ${{
    # zf: 모든 파일 중 검색해서 해당 파일 위치로 이동 및 선택

    # res=$(find . -maxdepth 4 -not -path '*/.*' -type f | fzf --reverse --header='Search File')
    res=$(find . -maxdepth 4 -not -path '*/.*' -type f | fzf --header='Search File')

    if [ -n "$res" ]; then
        # 파일이 있는 디렉토리로 이동 후 해당 파일 선택(select)
        lf -remote "send $id select \"$res\""
    fi
}}

cmd fzf_all ${{
    res=$(find . -maxdepth 3 -not -path '*/.*' | fzf)

    if [ -n "$res" ]; then
        # 파일이 있는 디렉토리로 이동 후 해당 파일 선택(select)
        if [ -d "$res" ]; then
            lf -remote "send $id cd \"$res\""
        elif [ -f "$res" ]; then
            lf -remote "send $id select \"$res\""
        fi
    fi
}}
