super + ctrl + r
    /usr/bin/pkill -usr1 -x sxhkd

super + Tab
    /usr/bin/rofi -show window -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + Escape
    /usr/bin/rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

alt + F2
    /usr/bin/rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + r
    /usr/bin/rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + s
    /usr/bin/rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + alt + Delete
    /usr/bin/mate-session-save --logout-dialog

super + l
    /usr/bin/loginctl lock-session
    # /usr/bin/mate-screensaver-command --lock

Print
    /usr/bin/mate-screenshot --interactive

super + p
    /usr/bin/mate-display-properties

ctrl + shift + Escape
    /usr/bin/mate-system-monitor

super + e
    /usr/bin/caja

super + i
    /usr/bin/mate-control-center

ctrl + alt + t
    /usr/bin/mate-terminal

super + x
    /usr/bin/xkill


