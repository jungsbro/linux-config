super + shift + r
    icewm --restart
    # fluxbox-remote restart
    # jwm-restart

super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    skippy-xd --expose --desktop -1

ctrl + Escape
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

alt + F2
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + r
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + s
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + alt + Delete
    [ "$(echo -e "No\nYes" | rofi -dmenu -p "logout?" -i)" = "Yes" ] && \
    loginctl terminate-session $(loginctl list-sessions | grep $USER | awk '\{print $1\}')

super + l
    loginctl lock-session

Print
    gnome-screenshot -i
    # flameshot gui

super + p
    arandr

ctrl + shift + Escape
    xfce4-terminal -e htop

super + e
    pcmanfm
    # xfce4-terminal -e ranger

super + i


ctrl + alt + t
    xfce4-terminal

super + x
    xkill


