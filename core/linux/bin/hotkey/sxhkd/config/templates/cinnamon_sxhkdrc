super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    cinnamon-dbus-command ShowOverview

ctrl + Escape
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

alt + F2
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + r
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + s
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + alt + Delete
    cinnamon-session-quit --logout

super + l
    loginctl lock-session
    # cinnamon-screensaver-command --lock

Print
    gnome-screenshot -i

super + p
    cinnamon-settings display

ctrl + shift + Escape
    gnome-system-monitor

super + e
    nemo

super + i
    cinnamon-settings

ctrl + alt + t
    gnome-terminal

super + x
    xkill


