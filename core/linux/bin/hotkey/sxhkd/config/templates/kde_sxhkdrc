super + ctrl + r
    /usr/bin/pkill -usr1 -x sxhkd

super + Tab
    /usr/bin/qdbus6 org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut 'Overview'

ctrl + Escape
    /usr/bin/qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.activateLauncherMenu

alt + F2
    /usr/bin/krunner

super + r
    /usr/bin/krunner

super + s
    /usr/bin/krunner

ctrl + alt + Delete
    /usr/bin/qdbus6 org.kde.LogoutPrompt /LogoutPrompt org.kde.LogoutPrompt.promptLogout

super + l
    /usr/bin/loginctl lock-session
    # /usr/libexec/kscreenlocker_greet --testing
    # /usr/lib/x86_64-linux-gnu/libexec/kscreenlocker_greet --testing

Print
    /usr/bin/spectacle

super + p
    /usr/bin/systemsettings kcm_kscreen

ctrl + shift + Escape
    /usr/bin/plasma-systemmonitor

super + e
    /usr/bin/dolphin

super + i
    /usr/bin/systemsettings

ctrl + alt + t
    /usr/bin/konsole

super + x
    /usr/bin/xkill


