super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    qdbus6 org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut 'Overview'

ctrl + Escape
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.activateLauncherMenu

alt + F2
    krunner

super + r
    krunner

super + s
    krunner

ctrl + alt + Delete
    qdbus6 org.kde.LogoutPrompt /LogoutPrompt org.kde.LogoutPrompt.promptLogout

super + l
    loginctl lock-session
