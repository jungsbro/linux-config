super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    skippy-xd --desktop -1
    # skippy-xd --expose --desktop -1

ctrl + Escape
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

alt + F2
    lxqt-runner

super + r
    lxqt-runner

super + s
    lxqt-runner

ctrl + alt + Delete
    lxqt-leave --logout

super + l
    loginctl lock-session
    # loginctl lock-session

Print
    screengrab

super + p
    lxqt-config-monitor

ctrl + shift + Escape
    qps

super + e
    pcmanfm-qt

super + i
    lxqt-config

ctrl + alt + t
    qterminal

super + x
    xkill


