super + shift + r
    openbox --reconfigure

super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    skippy-xd --expose --desktop -1

ctrl + Escape
    lxpanelctl menu

alt + F2
    rofi -show drun -theme "~/.config/rofi/themes/j_launcher.rasi"

super + r
    lxpanelctl run

super + s
    rofi -show drun -theme "~/.config/rofi/themes/j_launcher.rasi"

ctrl + alt + Delete
    lxde-logout

super + l
    loginctl lock-session
    # lxlock

Print
    gnome-screenshot -i

super + p
    lxrandr

ctrl + shift + Escape
    lxtask

super + e
    pcmanfm

super + i
    python3 ~/.local/bin/lxcc.py

ctrl + alt + t
    lxterminal

super + x
    xkill


