super + shift + r
    /usr/bin/openbox --reconfigure

super + ctrl + r
    /usr/bin/pkill -usr1 -x sxhkd

super + Tab
    /usr/bin/rofi -show window -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + Escape
    /usr/bin/lxpanelctl menu

alt + F2
    /usr/bin/rofi -show drun -theme "~/.config/rofi/themes/j_launcher.rasi"

super + r
    /usr/bin/lxpanelctl run

super + s
    /usr/bin/rofi -show drun -theme "~/.config/rofi/themes/j_launcher.rasi"

ctrl + alt + Delete
    /usr/bin/lxde-logout

super + l
    /usr/bin/loginctl lock-session
    # /usr/bin/lxlock

Print
    /usr/bin/gnome-screenshot -i

super + p
    /usr/bin/lxrandr

ctrl + shift + Escape
    /usr/bin/lxtask

super + e
    /usr/bin/pcmanfm

super + i
    /usr/bin/python3 ~/.local/bin/lxcc.py

ctrl + alt + t
    /usr/bin/lxterminal

super + x
    /usr/bin/xkill


