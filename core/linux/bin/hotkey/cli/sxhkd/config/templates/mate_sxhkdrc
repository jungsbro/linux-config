super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    skippy-xd --desktop -1
    # skippy-xd --expose --desktop -1

ctrl + Escape
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

alt + F2
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + r
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + s
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + alt + Delete
    mate-session-save --logout-dialog

super + l
    loginctl lock-session
    # mate-screensaver-command --lock

Print
    mate-screenshot --interactive

super + p
    mate-display-properties

ctrl + shift + Escape
    mate-system-monitor

super + e
    caja

super + i
    mate-control-center

ctrl + alt + t
    mate-terminal

super + x
    xkill


