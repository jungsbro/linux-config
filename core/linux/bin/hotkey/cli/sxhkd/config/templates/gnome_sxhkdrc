super + ctrl + r
    pkill -usr1 -x sxhkd

super + Tab
    skippy-xd --desktop -1
    # skippy-xd --expose --desktop -1

ctrl + Escape
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

alt + F2
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + r
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

super + s
    rofi -show drun -theme '~/.config/rofi/themes/j_launcher.rasi'

ctrl + alt + Delete
    gnome-session-quit --logout

super + l
    loginctl lock-session
    # xdg-screensaver lock

Print
    gnome-screenshot -i

super + p
    gnome-control-center display

ctrl + shift + Escape
    gnome-system-monitor

super + e
    nautilus

super + i
    gnome-control-center

ctrl + alt + t
    gnome-terminal

super + x
    xkill


