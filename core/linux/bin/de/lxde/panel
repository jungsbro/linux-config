# lxpanel <profile> config file. Manually editing is not recommended.
# Use preference dialog in lxpanel to adjust config when you can.

Global {
  edge=bottom
  align=left
  margin=0
  widthtype=percent
  width=100
  height=40
  transparent=0
  tintcolor=#000000
  alpha=0
  setdocktype=1
  setpartialstrut=1
  autohide=0
  heightwhenhidden=0
  usefontcolor=0
  fontcolor=#ffffff
  background=0
  backgroundfile=/usr/share/lxpanel/images/background.png
}
Plugin {
  type=space
  Config {
    Size=2
  }
}
Plugin {
  type=menu
  Config {
    image=/usr/share/lxde/images/lxde-icon.png
    system {
    }
    separator {
    }
    item {
      command=run
    }
    separator {
    }
    item {
      image=gnome-logout
      command=logout
    }
  }
}
Plugin {
  type=wincmd
  Config {
    Button1=iconify
    Button2=shade
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      id=lxde-x-www-browser.desktop
    }
    Button {
      id=firefox-esr.desktop
    }
    Button {
      id=doublecmd.desktop
    }
    Button {
      id=lxterminal.desktop
    }
    Button {
      id=org.xfce.mousepad.desktop
    }
    Button {
      id=code.desktop
    }
    Button {
      id=galculator.desktop
    }
    Button {
      id=org.kde.kolourpaint.desktop
    }
    Button {
      id=org.remmina.Remmina.desktop
    }
    Button {
      id=FreeFileSync.desktop
    }
  }
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=space
  Config {
    Size=4
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=1
    IconsOnly=0
    AcceptSkipPager=1
    ShowIconified=1
    ShowMapped=1
    ShowAllDesks=0
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=0
    MaxTaskWidth=150
    spacing=1
  }
}
Plugin {
  type=pager
  Config {
  }
}
Plugin {
  type=weather
  Config {
    alias="06272"
    city="06272"
    country=South Korea
    units=c
    latitude=37.491705
    longitude=127.042522
    interval=20
    enabled=1
    provider=openweathermap
  }
}
Plugin {
  type=monitors
  Config {
    DisplayCPU=1
    DisplayRAM=1
    CPUColor=#0000FF
    RAMColor=#FF0000
  }
}
Plugin {
  type=thermal
  Config {
    NormalColor=#00ff00
    Warning1Color=#fff000
    Warning2Color=#ff0000
    AutomaticLevels=1
    Warning1Temp=140
    Warning2Temp=145
    AutomaticSensor=1
  }
}
Plugin {
  type=volume
  Config {
    VolumeMuteKey=XF86AudioMute
    VolumeDownKey=XF86AudioLowerVolume
    VolumeUpKey=XF86AudioRaiseVolume
  }
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=dclock
  Config {
    ClockFmt=     %p %I:%M\n%y-%m-%d (%a)
    TooltipFmt=%A %x
    BoldFont=0
    IconOnly=0
    CenterText=0
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      id=lxde-screenlock.desktop
    }
    Button {
      id=lxde-logout.desktop
    }
  }
}
